{
  "id": "stagecraft",
  "title": "Stagecraft",
  "description": "Mood images as backgrounds of a single stage scene, and NPC cards as a scene-independent HTML layer.",
  "version": "0.1.0",
  "compatibility": {
    "minimum": "13.351",
    "verified": "13.351",
    "maximum": "13"
  },
  "authors": [
    {
      "name": "Celldweller"
    }
  ],
  "url": "https://github.com/Celldweller/stagecraft",
  "license": "LICENSE",
  "bugs": "https://github.com/Celldweller/stagecraft/issues",
  "manifest": "https://github.com/Celldweller/stagecraft/releases/latest/download/module.json",
  "download": "https://github.com/Celldweller/stagecraft/releases/latest/download/module.zip",
  "esmodules": [
    "scripts/stagecraft.mjs"
  ],
  "styles": [
    {
      "src": "styles/stagecraft.css"
    }
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "de",
      "name": "Deutsch",
      "path": "lang/de.json"
    }
  ],
  "socket": true,
  "flags": {
    "hotReload": {
      "extensions": ["css", "hbs", "json"]
    }
  }
}
